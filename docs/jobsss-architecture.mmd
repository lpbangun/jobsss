---
title: "JobSSS — one bundled runtime, one skill, and two optional companion Agent Plugins"
---
flowchart TB
  subgraph HOST["AGENT HOST (outside the plugin)"]
    Agent["Host agent model<br/>Hermes · Claude Code · Codex"]
    Adapters["Thin client adapters · compat/<br/>pointers only · no duplicated policy"]
  end

  subgraph COMPANIONS["COMPANION PLUGINS — optional, separate Agent Plugins from the same pack"]
    Pack["compat/hermes/find-people.pack.yaml<br/>one install · three pinned commits"]
    PF["people-finder — skills/people-finder<br/>typed-anchor candidate leads · offline · no state"]
    CB["contact-brief — skills/contact-brief<br/>cited contact brief compiler · offline · no MCP server"]
  end

  subgraph PLUGIN["JobSSS PLUGIN — portable, self-contained (Agent Plugins 1.0.0)"]
    Skill["Skill: skills/jobsss/SKILL.md<br/>slash routes + behavior contract"]
    Launcher["bin/jobsss launcher<br/>source: Node 22+ on PATH · release: nothing on PATH"]
    MCP["MCP stdio server 'jobsss'<br/>47 tools · JSON-RPC 2.0"]
    D1["domain.js<br/>doctor · start · intake · lifecycle · tasks"]
    D2["workflows.js · documents.js<br/>materials · answers · native PDF"]
    D3["scoring.js<br/>jobos.fit-score.v1 · 7 weighted dimensions"]
    D4["discovery.js · relationships.js<br/>ATS boards · contacts · network paths"]
    Store["store.js — versioned canonical state<br/>projections + audit mirror"]
    Contracts["contracts/ — packet · outcome · bulk-input<br/>offline validators · stable error codes"]
    Authority["authority.js — human-only decisions<br/>CLI only · never on tools/list"]
  end

  subgraph DATA["PLUGIN_DATA — host-provided, writable (only durable state root)"]
    S1["store.json — canonical, schemaVersion 2"]
    S2["projections/*.json + audit.md — readable mirrors"]
    S3["job · document · profile payloads (incl. exported PDFs)"]
  end

  subgraph EXT["EXTERNAL (outside the plugin)"]
    Human["Human operator<br/>bin/jobsss decide · 12 actions<br/>id + revision + contentHash"]
    Public["Public HTTP(S)<br/>job pages · public ATS boards"]
  end

  subgraph NEVER["NEVER through MCP — blocked, not attestable (policy)"]
    N1["send · submit · apply"]
    N2["approve · verify"]
    N3["schedule · browser automation"]
  end

  Agent -->|"loads the skill"| Skill
  Adapters -.->|"points at the canonical skill"| Skill
  Pack -->|"pins and installs"| Launcher
  Pack -->|"pins and installs"| PF
  Pack -->|"pins and installs"| CB
  Agent -->|"MCP tool calls"| PF
  Agent -->|"terminal: compiler CLI"| CB
  Agent -->|"host-supplied evidence"| MCP
  Skill -->|"MCP tool calls"| MCP
  Launcher --> MCP
  MCP --> D1 & D2 & D3 & D4
  D1 --> Store
  D2 --> Store
  D3 --> Store
  D4 --> Store
  D4 -.->|"public intake only"| Public
  Store -->|"persists"| S1
  S1 --> S2
  S1 --> S3
  Store --> Contracts
  MCP -.->|"non-authoritative handoffs"| Human
  Human -->|"trusted local decision"| Authority
  Authority -->|"records human observation"| S1
  PF -.->|"leads, never identity or contact"| Agent
  CB -.->|"contact-brief.v1, never a send"| Agent

  classDef blocked fill:#3f1220,stroke:#fb7185,color:#fecdd3;
  classDef companion fill:#1e293b,stroke:#7dd3fc,color:#e0f2fe,stroke-dasharray:4 3;
  class N1,N2,N3 blocked;
  class Pack,PF,CB companion;
